# 本机 Ollama：MODEL_MODE=ollama 时不需要 API Key。
MODEL_MODE=ollama
MODEL_BASE_URL=http://127.0.0.1:11434
MODEL_API_KEY=
MODEL_NAME=qwen3.6-27b-tools:latest

# 远端 DeepSeek 示例：将上面四项替换为下面的值，并在本机 .env 填入真实密钥。
# MODEL_MODE=openai
# MODEL_BASE_URL=https://api.deepseek.com
# MODEL_API_KEY=在这里填写你的DeepSeek_API_Key
# MODEL_NAME=deepseek-flash
# MODEL_BASE_URL 只填 API 基地址；程序会自动追加 /chat/completions。
# 其他兼容 OpenAI Chat Completions 的服务也使用 openai 模式，按服务商文档修改地址和模型名。
MODEL_REQUEST_TIMEOUT_MS=300000
MODEL_REVIEW_TIMEOUT_MS=120000
MODEL_ROUTE_TIMEOUT_MS=180000
# Optional: enables public web research during planning and file implementation.
BRAVE_SEARCH_API_KEY=
# Optional: copy .mcp.example.json to .mcp.json and set this path to add GitHub MCP.
JARVIS_MCP_CONFIG=
# Only used by the optional GitHub MCP server. Keep the real value in .env.
GITHUB_PERSONAL_ACCESS_TOKEN=
JARVIS_DATA_DIR=./data
JARVIS_WORKSPACE_ROOT=.
HOST=127.0.0.1
PORT=3000
